{
  "manifest_version": 3,
  "name": "KeepActive (Full)",
  "short_name": "KeepActive",
  "version": "1.1.0",
  "description": "Keeps your display awake, sends small activity events to Teams Web, and includes an optional native desktop helper.",
  "minimum_chrome_version": "116",

  "permissions": [
    "power",
    "idle",
    "alarms",
    "storage",
    "nativeMessaging"
  ],

  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "KeepActive (Full)",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "lib/random.js",
        "lib/logger.js",
        "lib/storage.js",
        "content/teams.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "commands": {
    "toggle-keepactive": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle KeepActive on/off"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
